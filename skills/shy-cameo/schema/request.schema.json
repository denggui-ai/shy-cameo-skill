{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "prompt", "referenced_image_paths", "card_ref", "max_refs", "sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"},
    "prompt": {"type": "string", "minLength": 1},
    "referenced_image_paths": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "minLength": 1}},
    "card_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "revision"],
      "properties": {
        "scene_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
        "revision": {"type": "integer"}
      }
    },
    "max_refs": {"type": "integer"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["set_id", "index", "role"],
      "properties": {
        "set_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "index": {"enum": [1, 2, 3, 4, 5]},
        "role": {"enum": ["cover", "wide", "interaction", "shy", "ending"]}
      }
    }
  }
}
