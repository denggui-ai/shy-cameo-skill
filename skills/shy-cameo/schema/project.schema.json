{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "character",
    "series",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "photo_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "maxItems": 2
    },
    "preferences": {
      "type": "object"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "series_id",
          "title",
          "brief",
          "sets"
        ],
        "properties": {
          "series_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "brief": {
            "type": "string",
            "minLength": 1
          },
          "sets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "set_id",
                "card"
              ],
              "properties": {
                "set_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "card": {
                  "type": "string",
                  "minLength": 1
                },
                "shots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "index",
                      "candidates"
                    ],
                    "properties": {
                      "index": {
                        "enum": [
                          1,
                          2,
                          3,
                          4,
                          5
                        ],
                        "type": "integer"
                      },
                      "candidates": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "run_id",
                            "scene_card"
                          ],
                          "properties": {
                            "run_id": {
                              "type": "string",
                              "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"
                            },
                            "scene_card": {
                              "type": "string",
                              "minLength": 1
                            }
                          }
                        }
                      },
                      "selected_run_id": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[0-9]{8}-[0-9]{6}-[0-9a-f]{6}$"
                      }
                    }
                  },
                  "maxItems": 5
                }
              }
            }
          }
        }
      }
    },
    "selection": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    },
    "continued": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
